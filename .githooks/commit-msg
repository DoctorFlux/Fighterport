#!/bin/sh
# Enforce the owner's requested attribution policy for this repository.
set -eu
owner='DoctorFlux <100806234+DoctorFlux@users.noreply.github.com>'
for identity in "$(git var GIT_AUTHOR_IDENT)" "$(git var GIT_COMMITTER_IDENT)"; do
  case "$identity" in
    "$owner "*) ;;
    *) printf '%s\n' 'Commit rejected: use the verified repository-owner author and committer identity.' >&2; exit 1 ;;
  esac
done
trailers=$(git interpret-trailers --parse "$1" | tr '[:upper:]' '[:lower:]')
case "$trailers" in
  *co-authored-by:*) printf '%s\n' 'Commit rejected: additional coauthor trailers are not permitted.' >&2; exit 1 ;;
esac
